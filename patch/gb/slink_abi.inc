; Shared GB mailbox ABI. Numeric ASCII is required under pret's game charmap.
; Gen 1 source: patch/gen1/src/slink.asm; pureRGB allocates the same 14-byte core.
IF !DEF(SLINK_GB_ABI_INCLUDED)
DEF SLINK_GB_ABI_INCLUDED EQU 1

DEF SLINK_BEACON_0 EQU $53
DEF SLINK_BEACON_1 EQU $4c
DEF SLINK_BEACON_2 EQU $4e
DEF SLINK_BEACON_3 EQU $4b
DEF SLINK_ABI_VERSION EQU 3

DEF SLINK_OFS_VERSION       EQU 4
DEF SLINK_OFS_FRAME_COUNTER EQU 5 ; little-endian word
DEF SLINK_OFS_SFX_REQUEST   EQU 7 ; host request, zero means idle
DEF SLINK_OFS_CAPS          EQU 8
DEF SLINK_OFS_PANEL_STATE   EQU 9
DEF SLINK_OFS_PANEL_PAGE    EQU 10
DEF SLINK_OFS_PANEL_PAGES   EQU 11
DEF SLINK_OFS_SFX_HOLD      EQU 12 ; ROM-private hold flag
DEF SLINK_OFS_SFX_HOLD_AT   EQU 13 ; ROM-private counter low-byte stamp
DEF SLINK_CORE_SIZE         EQU 14

DEF SLINK_CAP_SFX        EQU 1 << 0
DEF SLINK_CAP_PANEL      EQU 1 << 1
DEF SLINK_CAP_SFX_NOTIFY EQU 1 << 2
DEF SLINK_PANEL_CLOSED EQU 0
DEF SLINK_PANEL_AWAIT  EQU 1
DEF SLINK_PANEL_STAGED EQU 2
DEF SLINK_SFX_SUCCESS EQU 1
DEF SLINK_SFX_FAILURE EQU 2
DEF SLINK_SFX_BOO     EQU 3
DEF SLINK_SFX_NOTIFY  EQU 4

; O-27 D2 reserves a trade lease after the existing core; not a capability grant.
DEF SLINK_OFS_TRADE_LEASE EQU SLINK_CORE_SIZE
DEF SLINK_TRADE_LEASE_SIZE EQU 16
DEF SLINK_PUBLIC_SIZE EQU SLINK_OFS_TRADE_LEASE + SLINK_TRADE_LEASE_SIZE
ENDC
