 .../pkrandom/config/polished_offsets.ini      |   3 +
 .../pkrandom/constants/PolishedConstants.java |   9 +
 .../PolishedCrystalRomHandler.java            | 263 +++++++++++++++++-
 4 files changed, 280 insertions(+), 6 deletions(-)

