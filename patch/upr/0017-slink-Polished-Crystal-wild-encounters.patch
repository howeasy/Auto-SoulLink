+    public static final int grassRecordLength = 2 + 3 + 3 * 7 * 3, waterRecordLength = 2 + 1 + 3 * 3;
+    public static final int grassSlotsPerTime = 7, waterSlots = 3, maxPlainLevel = 100;
+    public static final int fishGroupLength = 8; // FISHGROUP_DATA_LENGTH: 2 chance bytes + 3 rod pointers
