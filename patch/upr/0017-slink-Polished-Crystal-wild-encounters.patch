     public static final int egg = 0xFF, unusedSpecies = 0x100; // constants/pokemon_constants.asm:280-281
+    public static final int unown = 0xC9; // constants/pokemon_constants.asm:226 (letters are forms)
+
+    // wild data, data/wild/*.asm. A slot's species is the "dp" right after its level byte
