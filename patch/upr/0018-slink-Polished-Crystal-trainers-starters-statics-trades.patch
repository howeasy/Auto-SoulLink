+            tr.tag = "GYM" + (c - 3);
+        } else if (c >= 17 && c <= 24) {
+            tr.tag = "GYM" + (c - 8);
+        } else if (c >= 12 && c <= 15) {
+            tr.tag = "ELITE" + (c - 11);
+        } else if (c == 16) {
+            tr.tag = "CHAMPION";
+        } else if (c >= 27 && c <= 31) {
+            boolean rival = c <= 29;
+            int battle = k / 3 + 1 + (c == 28 ? 1 : c == 29 ? 5 : c == 31 ? 4 : 0);
+            tr.tag = (rival ? "RIVAL" : "FRIEND") + battle + "-" + (rival ? (k % 3 + 1) % 3 : k % 3);
+            tr.forceStarterPosition = tr.pokemon.size() - 1;
+        }
+    }
