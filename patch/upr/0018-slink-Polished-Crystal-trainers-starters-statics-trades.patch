+    /**
+     * Script sites are species-byte offsets resolved on the release ROM (SLink data/polished/script_sites.json):
+     * each must sit right after a givepoke/loadwildmon opcode and carry PLAIN_FORM, else the INI is stale for
+     * this ROM and loading stops here instead of writing into script bytecode.
+     */
+    private void loadScriptSites() {
+        starterSites = intList("StarterSites");
+        staticSites = new ArrayList<>();
+        for (int i = 0; romEntry.entries.containsKey("StaticSite" + i) || romEntry.strings.containsKey("StaticSite" + i); i++) {
+            staticSites.add(intList("StaticSite" + i));
+        }
+        List<int[]> all = new ArrayList<>(staticSites);
+        all.add(starterSites);
+        for (int[] sites : all) {
+            for (int off : sites) {
+                int op = rom[off - 1] & 0xFF;
+                if ((op != PolishedConstants.givepokeCommand && op != PolishedConstants.loadwildmonCommand)
+                        || (rom[off + 1] & PolishedConstants.formMask) != PolishedConstants.plainForm || !plainSite(off)) {
+                    throw new IllegalStateException(String.format("Polished Crystal: no plain givepoke/loadwildmon species at 0x%X", off));
+                }
+            }
+        }
+    }
