+    //
+    // Every writer here rewrites only a site's two species bytes, in place: LOW(species), then
+    // HIGH(species) << 5 with the site's own gender and form bits kept. A site is in the model only when
+    // its form is NO_FORM or PLAIN_FORM; formed mons (ALOLAN_FORM, the Magikarp patterns, ...) are never
+    // read, so never written. Anything the model changed that is not a species (a level outside a static,
+    // an item, moves, a party size, a nickname) is refused with an exception, never written.
+
+    /** A "dp" this cut may rewrite: a real species with NO_FORM or PLAIN_FORM (gender bits allowed). */
+    private boolean plainSite(int offset) {
+        int lo = rom[offset] & 0xFF, hi = rom[offset + 1] & 0xFF;
+        int species = PolishedConstants.species9(lo, hi), form = hi & PolishedConstants.formMask;
+        return species >= 1 && species <= speciesCount
+                && (form == PolishedConstants.noForm || form == PolishedConstants.plainForm);
+    }
+
+    private Pokemon pokemonAt(int offset) {
+        return pokes[PolishedConstants.species9(rom[offset] & 0xFF, rom[offset + 1] & 0xFF)];
+    }
+
+    /**
+     * Writes pk at a site unless it is already there. pk must be placeable: a variant form folds to its
+     * species (the site's own form byte stays), and EGG, the unused $100 and Unown are refused.
+     */
+    private void writeSpecies(int offset, Pokemon pk, String what) {
+        if (pk == pokemonAt(offset)) {
+            return;
+        }
+        Pokemon base = pk.baseForme != null ? pk.baseForme : pk;
+        if (bannedForWildEncounters().contains(base) || base.number < 1 || base.number > speciesCount) {
+            throw new IllegalStateException("Polished Crystal: " + pk.fullName() + " cannot be " + what);
+        }
+        rom[offset] = (byte) (base.number & 0xFF);
+        rom[offset + 1] = (byte) ((rom[offset + 1] & ~PolishedConstants.extSpeciesMask) | ((base.number >> 8) << 5));
+    }
