+    /** A comma-separated INI list ("0xA48C0,0xA4919"); a single number is a one-element list. */
+    private int[] intList(String key) {
+        Long one = romEntry.entries.get(key);
+        if (one != null) {
+            return new int[] { (int) (long) one };
+        }
+        String s = romEntry.strings.get(key);
+        if (s == null) {
+            throw new IllegalStateException("polished_offsets.ini [" + romEntry.name + "] has no " + key);
+        }
+        String[] parts = s.split(",");
+        int[] out = new int[parts.length];
+        for (int i = 0; i < parts.length; i++) {
+            Long v = parseNumber(parts[i].trim());
+            if (v == null) {
+                throw new IllegalStateException("polished_offsets.ini " + key + ": not a number: " + parts[i]);
+            }
+            out[i] = (int) (long) v;
+        }
+        return out;
+    }
