+    private List<int[]> plainMons(TrainerRecord r) {
+        List<int[]> mons = new ArrayList<>();
+        for (int[] mon : r.mons) {
+            if (plainSite(mon[1])) {
+                mons.add(mon);
+            }
+        }
+        return mons;
+    }
