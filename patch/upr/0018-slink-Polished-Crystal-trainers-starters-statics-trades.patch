+    private IngameTrade readTrade(int o) {
+        IngameTrade t = new IngameTrade();
+        t.requestedPokemon = pokemonAt(o + PolishedConstants.tradeWanted);
+        t.givenPokemon = pokemonAt(o + PolishedConstants.tradeGiven);
