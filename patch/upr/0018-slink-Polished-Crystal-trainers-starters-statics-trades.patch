+     * INVER's entry points at WRAM (a party shuffled at run time) and is never walked.
+     */
+    private List<TrainerRecord> walkTrainers() {
+        int table = romEntry.getValue("TrainerDataTableOffset");
+        int[] counts = intList("TrainerClassCounts");
+        int inver = romEntry.getValue("InverTrainerClass");
+        if (counts.length != romEntry.getValue("TrainerClassCount")) {
+            throw new IllegalStateException("Polished Crystal: TrainerClassCounts has " + counts.length + " classes");
+        }
+        List<TrainerRecord> records = new ArrayList<>();
+        for (int c = 0; c < counts.length; c++) {
+            if (c + 1 == inver) {
+                continue;
+            }
+            int bank = rom[table + 3 * c] & 0xFF, addr = readWord(table + 3 * c + 1);
+            if (addr < 0x4000 || addr >= 0x8000) {
+                throw new IllegalStateException(String.format("Polished Crystal: trainer class %d party pointer %02X:%04X", c + 1, bank, addr));
+            }
+            int p = calculateOffset(bank, addr);
+            for (int t = 0; t < counts[c]; t++) {
+                TrainerRecord r = new TrainerRecord();
+                r.trainerClass = c + 1;
+                r.instance = t;
+                r.start = p;
+                int end = p + 1 + (rom[p] & 0xFF);
+                int q = p + 1;
+                r.name = readName(q, end - q);
+                while ((rom[q] & 0xFF) != PolishedConstants.textTerminator) {
+                    q++;
+                }
+                q++;
+                int flags = rom[q++] & 0xFF;
+                r.items = (flags & PolishedConstants.trItem) != 0;
+                r.moves = (flags & PolishedConstants.trMoves) != 0;
+                while (q < end) {
+                    int[] mon = { q, q + 1, -1, -1 };
+                    q += 3;
+                    if (r.items) {
+                        mon[2] = q++;
+                    }
+                    q += ((flags & PolishedConstants.trDVs) != 0 ? 1 : 0) + ((flags & PolishedConstants.trPersonality) != 0 ? 1 : 0);
+                    if ((flags & PolishedConstants.trNickname) != 0) {
+                        while ((rom[q] & 0xFF) != PolishedConstants.textTerminator) {
+                            q++;
+                        }
+                        q++;
+                    }
+                    q += (flags & PolishedConstants.trEVs) != 0 ? 1 : 0;
+                    if (r.moves) {
+                        mon[3] = q;
+                        q += 4;
+                    }
+                    r.mons.add(mon);
+                }
+                if (q != end) {
+                    throw new IllegalStateException(String.format("Polished Crystal: trainer %d/%d at 0x%X parses to 0x%X, its size says 0x%X",
