diff --git a/src/com/dabomstew/pkrandom/romhandlers/PolishedCrystalRomHandler.java b/src/com/dabomstew/pkrandom/romhandlers/PolishedCrystalRomHandler.java
new file mode 100644
index 0000000..e53a491
--- /dev/null
+++ b/src/com/dabomstew/pkrandom/romhandlers/PolishedCrystalRomHandler.java
@@ -0,0 +1,946 @@
+package com.dabomstew.pkrandom.romhandlers;
+
+/*----------------------------------------------------------------------------*/
+/*--  PolishedCrystalRomHandler.java - SLink fork handler for Polished      --*/
+/*--  Crystal 3.2.3 (cut 1: load, read-only model, lossless save).          --*/
+/*--                                                                        --*/
+/*--  Part of the SLink fork of "Universal Pokemon Randomizer ZX"; GPL v3   --*/
+/*--  like the rest of the randomizer. Design: docs/polished/UPR_HANDLER.md --*/
+/*--  in the SLink repository.                                              --*/
+/*----------------------------------------------------------------------------*/
+
+import java.awt.image.BufferedImage;
+import java.io.File;
+import java.io.FileNotFoundException;
+import java.io.PrintStream;
+import java.util.*;
+
+import com.dabomstew.pkrandom.FileFunctions;
+import com.dabomstew.pkrandom.Settings;
+import com.dabomstew.pkrandom.constants.GBConstants;
+import com.dabomstew.pkrandom.constants.PolishedConstants;
+import com.dabomstew.pkrandom.pokemon.*;
+
+/**
+ * Cut 1 loads the release ROM into UPR's model (detection, 291 species + 46 variant forms,
+ * base stats, the 8-byte moves, evolutions and learnsets) and saves it back field-scoped:
+ * with every setting off the output is byte-identical to the input. There are NO randomization
+ * writers yet: every setter throws, every feature query says "not supported", and names are
+ * placeholders because Polished's names are compressed text that is never written.
+ *
+ * Pokemon model: getPokemonInclFormes() index = BaseData record (1..337). Records 1..291 are
+ * species ids (formeNumber 0); 292..337 are the variant forms of VariantSpeciesAndFormTable,
+ * with baseForme = the species and formeNumber = the ROM form byte, so a ROM "dp" is
+ * (baseForme.number, formeNumber). Records 255 (EGG) and 256 (unused $100) are dummies.
+ */
+public class PolishedCrystalRomHandler extends AbstractGBCRomHandler {
+
+    public static class Factory extends RomHandler.Factory {
+
+        @Override
+        public PolishedCrystalRomHandler create(Random random, PrintStream logStream) {
+            return new PolishedCrystalRomHandler(random, logStream);
+        }
+
+        public boolean isLoadable(String filename) {
+            long fileLength = new File(filename).length();
+            if (fileLength > 8 * 1024 * 1024) {
+                return false;
+            }
+            byte[] loaded = loadFilePartial(filename, 0x1000);
+            return loaded.length != 0 && detectRomInner(loaded, (int) fileLength);
+        }
+    }
+
+    public PolishedCrystalRomHandler(Random random) {
+        super(random, null);
+    }
+
+    public PolishedCrystalRomHandler(Random random, PrintStream logStream) {
+        super(random, logStream);
+    }
+
+    private static class RomEntry {
+        private String name;
+        private final Map<String, Long> entries = new HashMap<>();
+        private final Map<String, String> strings = new HashMap<>();
+
+        private int getValue(String key) {
+            Long v = entries.get(key);
+            if (v == null) {
+                throw new IllegalStateException("polished_offsets.ini [" + name + "] has no numeric " + key);
+            }
+            return (int) (long) v;
+        }
+
+        private String romCode() {
+            return strings.get("Game");
+        }
+    }
+
+    private static List<RomEntry> roms;
+
+    static {
+        loadROMInfo();
+    }
+
+    // Values that are not numbers (species names, "Unresolved", source cites) are kept as strings
+    // instead of being reported: the generated section carries them on purpose. A section header
+    // naming an existing entry re-opens it, and a later key wins (the hand-kept supplement).
+    private static void loadROMInfo() {
+        roms = new ArrayList<>();
+        RomEntry current = null;
+        try {
+            Scanner sc = new Scanner(FileFunctions.openConfig("polished_offsets.ini"), "UTF-8");
+            while (sc.hasNextLine()) {
+                String q = sc.nextLine().trim();
+                if (q.contains("//")) {
+                    q = q.substring(0, q.indexOf("//")).trim();
+                }
+                if (q.isEmpty()) {
+                    continue;
+                }
+                if (q.startsWith("[") && q.endsWith("]")) {
+                    String name = q.substring(1, q.length() - 1);
+                    current = null;
+                    for (RomEntry re : roms) {
+                        if (re.name.equals(name)) {
+                            current = re;
+                        }
+                    }
+                    if (current == null) {
+                        current = new RomEntry();
+                        current.name = name;
+                        roms.add(current);
+                    }
+                    continue;
+                }
+                String[] r = q.split("=", 2);
+                if (r.length != 2 || current == null) {
+                    continue;
+                }
+                String key = r[0].trim(), value = r[1].trim();
+                Long num = parseNumber(value);
+                if (num != null) {
+                    current.entries.put(key, num);
+                } else {
+                    current.strings.put(key, value);
+                }
+            }
+            sc.close();
+        } catch (FileNotFoundException e) {
+            System.err.println("File not found!");
+        }
+    }
+
+    private static Long parseNumber(String s) {
+        try {
+            String t = s.toLowerCase();
+            return t.startsWith("0x") ? Long.parseLong(t.substring(2), 16) : Long.parseLong(t);
+        } catch (NumberFormatException ex) {
+            return null;
+        }
+    }
+
+    // This ROM's data
+    private RomEntry romEntry;
+    private Pokemon[] pokes;            // index = BaseData record, 1..speciesCount+variantCount
+    private List<Pokemon> pokemonList, pokemonListInclFormes, altFormes;
+    private int speciesCount;
+    private int[] variantSpecies, variantForm;
+    private Move[] moves;
+    private Map<Integer, List<MoveLearnt>> movesets;
+    private long actualCRC32;
+
+    @Override
+    public boolean detectRom(byte[] rom) {
+        return detectRomInner(rom, rom.length);
+    }
+
+    private static boolean detectRomInner(byte[] rom, int romSize) {
+        RomEntry re = checkRomEntry(rom);
+        return re != null && romSize == re.getValue("RomSize");
+    }
+
+    // Exact match only: game code, version, non-Japanese flag and header checksum, the same
+    // tuple Gen2RomHandler reads, with no CRCInHeader wildcard.
+    private static RomEntry checkRomEntry(byte[] rom) {
+        if (rom.length < GBConstants.crcOffset + 2) {
+            return null;
+        }
+        int version = rom[GBConstants.versionOffset] & 0xFF;
+        int nonjap = rom[GBConstants.jpFlagOffset] & 0xFF;
+        int crcInHeader = ((rom[GBConstants.crcOffset] & 0xFF) << 8) | (rom[GBConstants.crcOffset + 1] & 0xFF);
+        for (RomEntry re : roms) {
+            if (re.romCode() != null && romCode(rom, re.romCode()) && re.getValue("Version") == version
+                    && re.getValue("NonJapanese") == nonjap && re.getValue("CRCInHeader") == crcInHeader) {
+                return re;
+            }
+        }
+        return null;
+    }
+
+    @Override
+    public void loadedRom() {
+        romEntry = checkRomEntry(this.rom);
+        speciesCount = romEntry.getValue("SpeciesCount");
+        int variantCount = romEntry.getValue("VariantFormCount");
+        int table = romEntry.getValue("VariantFormTableOffset");
+        variantSpecies = new int[variantCount];
+        variantForm = new int[variantCount];
+        for (int v = 0; v < variantCount; v++) {
+            int lo = rom[table + 2 * v] & 0xFF, hi = rom[table + 2 * v + 1] & 0xFF;
+            variantSpecies[v] = PolishedConstants.species9(lo, hi);
+            variantForm[v] = hi & PolishedConstants.formMask;
+        }
+        loadPokemonStats();
+        loadMoves();
+        loadEvolutionsAndMovesets();
+        actualCRC32 = FileFunctions.getCRC32(rom);
+    }
+
+    private int stride() {
+        return romEntry.getValue("BaseStatsEntrySize");
+    }
+
+    private void loadPokemonStats() {
+        int records = speciesCount + variantSpecies.length;
+        pokes = new Pokemon[records + 1];
+        int offs = romEntry.getValue("PokemonStatsOffset");
+        for (int i = 1; i <= records; i++) {
+            Pokemon pk = new Pokemon();
+            pk.number = i;
+            loadBasicPokeStats(pk, offs + (i - 1) * stride());
+            pokes[i] = pk;
+        }
+        altFormes = new ArrayList<>();
+        for (int i = 1; i <= records; i++) {
+            Pokemon pk = pokes[i];
+            if (i <= speciesCount) {
+                // ponytail: placeholder names; Polished's names are compressed text this cut never reads
+                pk.name = i == PolishedConstants.egg ? "EGG" : i == PolishedConstants.unusedSpecies
+                        ? "(unused)" : String.format("Species%03d", i);
+            } else {
+                int v = i - speciesCount - 1;
+                pk.baseForme = pokes[variantSpecies[v]];
+                pk.formeNumber = variantForm[v];
+                pk.formeSuffix = "-" + variantForm[v];
+                pk.name = pk.baseForme.name;
+                altFormes.add(pk);
+            }
+        }
+        pokemonListInclFormes = Arrays.asList(pokes);
+        pokemonList = Arrays.asList(Arrays.copyOf(pokes, speciesCount + 1));
+    }
+
+    private void loadBasicPokeStats(Pokemon pk, int offset) {
+        pk.hp = rom[offset + PolishedConstants.bsHP] & 0xFF;
+        pk.attack = rom[offset + PolishedConstants.bsAttack] & 0xFF;
+        pk.defense = rom[offset + PolishedConstants.bsDefense] & 0xFF;
+        pk.speed = rom[offset + PolishedConstants.bsSpeed] & 0xFF;
+        pk.spatk = rom[offset + PolishedConstants.bsSpAtk] & 0xFF;
+        pk.spdef = rom[offset + PolishedConstants.bsSpDef] & 0xFF;
+        int t1 = rom[offset + PolishedConstants.bsType1] & 0xFF, t2 = rom[offset + PolishedConstants.bsType2] & 0xFF;
+        pk.primaryType = PolishedConstants.byteToType(t1);
+        pk.secondaryType = t2 == t1 ? null : PolishedConstants.byteToType(t2);
+        pk.catchRate = rom[offset + PolishedConstants.bsCatchRate] & 0xFF;
+        pk.expYield = rom[offset + PolishedConstants.bsExp] & 0xFF;
+        pk.guaranteedHeldItem = -1;
+        pk.commonHeldItem = rom[offset + PolishedConstants.bsItem1] & 0xFF;
+        pk.rareHeldItem = rom[offset + PolishedConstants.bsItem2] & 0xFF;
+        pk.darkGrassHeldItem = -1;
+        int growth = rom[offset + PolishedConstants.bsGrowthRate] & 0xFF;
+        pk.growthCurve = growth < PolishedConstants.growthTable.length ? PolishedConstants.growthTable[growth] : null;
+    }
+
+    private void saveBasicPokeStats(Pokemon pk, int offset) {
+        rom[offset + PolishedConstants.bsHP] = (byte) pk.hp;
+        rom[offset + PolishedConstants.bsAttack] = (byte) pk.attack;
+        rom[offset + PolishedConstants.bsDefense] = (byte) pk.defense;
+        rom[offset + PolishedConstants.bsSpeed] = (byte) pk.speed;
+        rom[offset + PolishedConstants.bsSpAtk] = (byte) pk.spatk;
+        rom[offset + PolishedConstants.bsSpDef] = (byte) pk.spdef;
+        writeType(offset + PolishedConstants.bsType1, pk.primaryType);
+        writeType(offset + PolishedConstants.bsType2, pk.secondaryType == null ? pk.primaryType : pk.secondaryType);
+        rom[offset + PolishedConstants.bsCatchRate] = (byte) pk.catchRate;
+        rom[offset + PolishedConstants.bsExp] = (byte) pk.expYield;
+        rom[offset + PolishedConstants.bsItem1] = (byte) pk.commonHeldItem;
+        rom[offset + PolishedConstants.bsItem2] = (byte) pk.rareHeldItem;
+    }
+
+    /** A type with no Polished id (or none loaded, e.g. UNKNOWN_T) keeps the ROM's byte. */
+    private void writeType(int offset, Type type) {
+        int b = PolishedConstants.typeToByte(type);
+        if (b >= 0) {
+            rom[offset] = (byte) b;
+        }
+    }
+
+    private void loadMoves() {
+        int len = romEntry.getValue("MoveLength");
+        int offs = romEntry.getValue("MoveDataOffset");
+        moves = new Move[PolishedConstants.moveCount + 1];
+        for (int i = 1; i <= PolishedConstants.moveCount; i++) {
+            int o = offs + (i - 1) * len;
+            Move m = new Move();
+            m.name = String.format("Move%03d", i); // ponytail: placeholder, see the species names
+            m.number = i;
+            m.internalId = i;
+            m.effectIndex = rom[o + PolishedConstants.mvEffect] & 0xFF;
+            m.power = rom[o + PolishedConstants.mvPower] & 0xFF;
+            m.type = PolishedConstants.byteToType(rom[o + PolishedConstants.mvType] & 0xFF);
+            // Polished stores accuracy as a percent; 255 (-1 in moves.asm) = ignores accuracy checks
+            m.hitratio = rom[o + PolishedConstants.mvAcc] & 0xFF;
+            m.pp = rom[o + PolishedConstants.mvPP] & 0xFF;
+            int cat = rom[o + PolishedConstants.mvCategory] & 0xFF;
+            m.category = cat == 0 ? MoveCategory.PHYSICAL : cat == 1 ? MoveCategory.SPECIAL : MoveCategory.STATUS;
+            moves[i] = m;
+        }
+    }
+
+    private void saveMoves() {
+        int len = romEntry.getValue("MoveLength");
+        int offs = romEntry.getValue("MoveDataOffset");
+        for (int i = 1; i <= PolishedConstants.moveCount; i++) {
+            int o = offs + (i - 1) * len;
+            Move m = moves[i];
+            rom[o + PolishedConstants.mvPower] = (byte) m.power;
+            writeType(o + PolishedConstants.mvType, m.type);
+            rom[o + PolishedConstants.mvAcc] = (byte) (int) m.hitratio;
+            rom[o + PolishedConstants.mvPP] = (byte) m.pp;
+            rom[o + PolishedConstants.mvCategory] = (byte) (m.category == MoveCategory.PHYSICAL ? 0
+                    : m.category == MoveCategory.SPECIAL ? 1 : 2);
+        }
+    }
+
+    /** The record a ROM (species, form) pair resolves to: its variant form, else the species. */
+    private Pokemon pokeAt(int species, int form) {
+        for (int v = 0; v < variantSpecies.length; v++) {
+            if (variantSpecies[v] == species && variantForm[v] == form) {
+                return pokes[speciesCount + 1 + v];
+            }
+        }
+        return species >= 1 && species <= speciesCount ? pokes[species] : null;
+    }
+
+    // data/pokemon/evos_attacks.asm: per record, evo_data entries ($ff ends them) then
+    // learnset (level, move) pairs ($ff ends them); the pointer table is EvosAttacksPointers.
+    // Read-only in cut 1.
+    private void loadEvolutionsAndMovesets() {
+        movesets = new TreeMap<>();
+        int table = romEntry.getValue("PokemonMovesetsTableOffset");
+        int bank = bankOf(table);
+        for (int i = 1; i < pokes.length; i++) {
+            Pokemon from = pokes[i];
+            int p = calculateOffset(bank, readWord(table + (i - 1) * 2));
+            while ((rom[p] & 0xFF) != 0xFF) {
+                int method = rom[p++] & 0xFF;
+                int param;
+                if (method == PolishedConstants.evoParty) {
+                    param = PolishedConstants.species9(rom[p] & 0xFF, rom[p + 1] & 0xFF);
+                    p += 2;
+                } else {
+                    param = rom[p++] & 0xFF;
+                }
+                int extra = 0;
+                if (method == PolishedConstants.evoStat || method == PolishedConstants.evoHolding) {
+                    extra = rom[p++] & 0xFF;
+                }
+                int lo = rom[p] & 0xFF, hi = rom[p + 1] & 0xFF;
+                p += 2;
+                Pokemon to = pokeAt(PolishedConstants.species9(lo, hi), hi & PolishedConstants.formMask);
+                if (to == null) {
+                    continue;
+                }
+                // extraInfo = the method's first parameter (level, item, move, landmark, partner)
+                Evolution evo = new Evolution(from, to, true, evolutionType(method, param, extra), param);
+                if (!from.evolutionsFrom.contains(evo)) {
+                    from.evolutionsFrom.add(evo);
+                    to.evolutionsTo.add(evo);
+                }
+            }
+            p++;
+            List<MoveLearnt> learnt = new ArrayList<>();
+            while ((rom[p] & 0xFF) != 0xFF) {
+                MoveLearnt ml = new MoveLearnt();
+                ml.level = rom[p] & 0xFF;
+                ml.move = rom[p + 1] & 0xFF;
+                learnt.add(ml);
+                p += 2;
+            }
+            movesets.put(i, learnt);
+        }
+    }
+
+    // ponytail: nearest UPR type per Polished method; NONE where UPR has no equivalent
+    // (held item at any time, crit-count). Read-only, so nothing is written from it.
+    private static EvolutionType evolutionType(int method, int param, int extra) {
+        switch (method) {
+            case PolishedConstants.evoLevel:
+                return EvolutionType.LEVEL;
+            case PolishedConstants.evoItem:
+                return EvolutionType.STONE;
+            case PolishedConstants.evoTrade:
+                return param == 0xFF ? EvolutionType.TRADE : EvolutionType.TRADE_ITEM;
+            case PolishedConstants.evoHolding:
+                return extra == PolishedConstants.trMornDay ? EvolutionType.LEVEL_ITEM_DAY
+                        : extra == PolishedConstants.trEveNite ? EvolutionType.LEVEL_ITEM_NIGHT : EvolutionType.NONE;
+            case PolishedConstants.evoHappiness:
+                return param == PolishedConstants.trMornDay ? EvolutionType.HAPPINESS_DAY
+                        : param == PolishedConstants.trEveNite ? EvolutionType.HAPPINESS_NIGHT : EvolutionType.HAPPINESS;
+            case PolishedConstants.evoStat:
+                return extra == PolishedConstants.atkGtDef ? EvolutionType.LEVEL_ATTACK_HIGHER
+                        : extra == PolishedConstants.atkLtDef ? EvolutionType.LEVEL_DEFENSE_HIGHER
+                        : EvolutionType.LEVEL_ATK_DEF_SAME;
+            case PolishedConstants.evoLocation:
+                return EvolutionType.LEVEL_ELECTRIFIED_AREA;
+            case PolishedConstants.evoMove:
+                return EvolutionType.LEVEL_WITH_MOVE;
+            case PolishedConstants.evoParty:
+                return EvolutionType.LEVEL_WITH_OTHER;
+            default:
+                return EvolutionType.NONE;
+        }
+    }
+
+    // Field-scoped: only the base-stat and move bytes the model owns are written back, so with
+    // every setting off the ROM comes out byte-identical (LosslessMode=1, the pureRGB bar).
+    // Names, evolutions and learnsets are never written in cut 1.
+    @Override
+    public void savingRom() {
+        int offs = romEntry.getValue("PokemonStatsOffset");
+        for (int i = 1; i < pokes.length; i++) {
+            saveBasicPokeStats(pokes[i], offs + (i - 1) * stride());
+        }
+        saveMoves();
+    }
