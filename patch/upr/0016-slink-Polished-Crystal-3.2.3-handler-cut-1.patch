+package com.dabomstew.pkrandom.constants;
+
+/*----------------------------------------------------------------------------*/
+/*--  PolishedConstants.java - format facts for Polished Crystal 3.2.3      --*/
+/*--  (SLink fork). Offsets live in config/polished_offsets.ini; everything --*/
+/*--  an INI cannot express lives here. Cites are Polished v3.2.3 sources.  --*/
+/*----------------------------------------------------------------------------*/
+
+import com.dabomstew.pkrandom.pokemon.ExpCurve;
+import com.dabomstew.pkrandom.pokemon.Type;
+
+public class PolishedConstants {
+
+    // constants/type_constants.asm:7-23 (UNKNOWN_T = $12 has no UPR Type: null, byte kept on save)
+    public static final Type[] typeTable = {
+            Type.NORMAL, Type.FIGHTING, Type.FLYING, Type.POISON, Type.GROUND, Type.ROCK, Type.BUG,
+            Type.GHOST, Type.STEEL, Type.FIRE, Type.WATER, Type.GRASS, Type.ELECTRIC, Type.PSYCHIC,
+            Type.ICE, Type.DRAGON, Type.DARK, Type.FAIRY,
+    };
+
+    public static Type byteToType(int b) {
+        return b < typeTable.length ? typeTable[b] : null;
+    }
+
+    /** -1 when the type has no Polished id. */
+    public static int typeToByte(Type type) {
+        for (int i = 0; i < typeTable.length; i++) {
+            if (typeTable[i] == type) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    // constants/pokemon_data_constants.asm:67-71 (GROWTH_MEDIUM_FAST, _MEDIUM_SLOW, _FAST, _SLOW)
+    public static final ExpCurve[] growthTable = {
+            ExpCurve.MEDIUM_FAST, ExpCurve.MEDIUM_SLOW, ExpCurve.FAST, ExpCurve.SLOW,
+    };
+
+    // base data record (constants/pokemon_data_constants.asm:1-35, BASE_DATA_SIZE = 34)
+    public static final int bsHP = 0, bsAttack = 1, bsDefense = 2, bsSpeed = 3, bsSpAtk = 4, bsSpDef = 5,
+            bsType1 = 6, bsType2 = 7, bsCatchRate = 8, bsExp = 9, bsItem1 = 10, bsItem2 = 11,
+            bsGrowthRate = 16;
+
+    // move record (constants/battle_constants.asm:42-52, MOVE_LENGTH = 8)
+    public static final int mvAnim = 0, mvEffect = 1, mvPower = 2, mvType = 3, mvAcc = 4, mvPP = 5,
+            mvChance = 6, mvCategory = 7;
+    public static final int moveCount = 255; // constants/move_constants.asm:266-267, NUM_ATTACKS (STRUGGLE = $ff)
+    public static final int itemCount = 255; // held items are one byte (base_stats/*.asm "db NO_ITEM, NO_ITEM")
+
+    // 2-byte species, macros/data.asm:89-91 + constants/pokemon_data_constants.asm:244-247
+    public static final int extSpeciesMask = 0x20, formMask = 0x1F;
+    public static final int noForm = 0, plainForm = 1;
+
+    public static int species9(int lo, int hi) {
+        return lo | ((hi & extSpeciesMask) << 3);
+    }
+
+    // evolution methods, constants/pokemon_data_constants.asm:312-323
+    public static final int evoLevel = 1, evoItem = 2, evoTrade = 3, evoHolding = 4, evoHappiness = 5,
+            evoStat = 6, evoLocation = 7, evoMove = 8, evoCrit = 9, evoParty = 10;
+    // EVOLVE_HAPPINESS / EVOLVE_HOLDING time triggers (:344-347), EVOLVE_STAT triggers (:350-353)
+    public static final int trAnytime = 1, trMornDay = 2, trEveNite = 3;
+    public static final int atkGtDef = 1, atkLtDef = 2, atkEqDef = 3;
+
+    public static final int egg = 0xFF, unusedSpecies = 0x100; // constants/pokemon_constants.asm:280-281
+}
