diff --git a/src/com/dabomstew/pkrandom/romhandlers/Gen1RomHandler.java b/src/com/dabomstew/pkrandom/romhandlers/Gen1RomHandler.java
index d52754f..26ed6b9 100755
--- a/src/com/dabomstew/pkrandom/romhandlers/Gen1RomHandler.java
+++ b/src/com/dabomstew/pkrandom/romhandlers/Gen1RomHandler.java
@@ -2228,7 +2228,9 @@ public class Gen1RomHandler extends AbstractGBCRomHandler {
     @Override
     public int miscTweaksAvailable() {
         if (lossless()) {
-            return 0; // slink: every tweak is a code write; a lossless entry offers none
+            // slink: every other tweak is a code write; the name table is data, re-cased
+            // byte-for-byte in place (applyCamelCaseNamesInPlace), so it is the one offered
+            return MiscTweak.LOWER_CASE_POKEMON_NAMES.getValue();
         }
         int available = MiscTweak.LOWER_CASE_POKEMON_NAMES.getValue();
         available |= MiscTweak.UPDATE_TYPE_EFFECTIVENESS.getValue();
@@ -2273,7 +2275,11 @@ public class Gen1RomHandler extends AbstractGBCRomHandler {
         } else if (tweak == MiscTweak.ALLOW_PIKACHU_EVOLUTION) {
             applyPikachuEvoPatch();
         } else if (tweak == MiscTweak.LOWER_CASE_POKEMON_NAMES) {
-            applyCamelCaseNames();
+            if (lossless()) {
+                applyCamelCaseNamesInPlace();
+            } else {
+                applyCamelCaseNames();
+            }
         } else if (tweak == MiscTweak.UPDATE_TYPE_EFFECTIVENESS) {
             updateTypeEffectiveness();
         } else if (tweak == MiscTweak.RANDOMIZE_CATCHING_TUTORIAL) {
@@ -2286,6 +2292,38 @@ public class Gen1RomHandler extends AbstractGBCRomHandler {
         return effectivenessUpdated;
     }
 
+    // slink: RomFunctions.camelCase as a byte transform over the whole name table of a
+    // lossless entry (every InternalPokemonCount row: forms, spirits and MissingNo have
+    // their own), written straight into rom[] so nothing is re-encoded; savePokemonStats
+    // keeps skipping the name write on a lossless entry. Glyphs: A-Z $80-$99, a-z $A0-$B9,
+    // the 'x ligatures $BB-$BF/$E4/$E5, the apostrophe $E0, terminator/pad $50.
+    private void applyCamelCaseNamesInPlace() {
+        int offs = romEntry.getValue("PokemonNamesOffset");
+        int nameLength = romEntry.getValue("PokemonNamesLength");
+        int count = romEntry.getValue("InternalPokemonCount");
+        for (int i = 0; i < count; i++) {
+            boolean docap = true;
+            for (int j = 0; j < nameLength; j++) {
+                int at = offs + i * nameLength + j;
+                int b = rom[at] & 0xFF;
+                if (b == 0x50) {
+                    break;
+                }
+                if (b >= 0x80 && b <= 0x99) {
+                    if (!docap) {
+                        rom[at] = (byte) (b + 0x20);
+                    }
+                    docap = false;
+                } else if ((b >= 0xA0 && b <= 0xB9) || (b >= 0xBB && b <= 0xBF) || b == 0xE0 || b == 0xE4
+                        || b == 0xE5) {
+                    docap = false;
+                } else {
+                    docap = true;
+                }
+            }
+        }
+    }
+
     private void applyBWEXPPatch() {
         genericIPSPatch("BWXPTweak");
     }
