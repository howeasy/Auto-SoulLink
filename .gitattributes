# The overlay sources are hashed raw by overlay_provenance.json; keep them LF on every checkout.
patch/gen1/purergb/** text eol=lf
patch/upr/*.patch text eol=lf
# Gen 2 overlay sources, hashed into data/gen2/overlay_provenance.json (the builder also hashes them LF-normalized).
patch/gen2/src/** text eol=lf
patch/gb/slink_abi.inc text eol=lf

# These are hashed byte-for-byte against sha256 pins in data/games/gen1_rby/profile.json,
# data/games/gen1_purergb/profile.json, data/purergb/build_provenance.json and
# data/purergb/overlay_provenance.json. The pins were computed on LF bytes (CI, and the
# build tools' own writes); without this, Windows checkouts (core.autocrlf=true) see CRLF
# and every one of those hash checks mismatches (they passed on the original committer's
# machine only because autocrlf hadn't corrupted the checkout yet at generation time).
data/pret/*.sym text eol=lf
data/purergb/*.sym text eol=lf
data/purergb/*.map text eol=lf
data/polished/*.sym text eol=lf
data/polished/*.map text eol=lf

# Card X3-FIX: the expansion harness slices are hash-pinned byte-for-byte (SYM_SLICE_SHA256/
# MAP_SLICE_SHA256 in tools/gen_gen3_title_syms_exp.py) against their committed LF bytes -- same
# CRLF-corruption risk as the data/*.sym/*.map rules above.
data/games/gen3_exp/28877d73/harness_rows.sym text eol=lf
data/games/gen3_exp/28877d73/harness_map_slice.txt text eol=lf

# Gen 3: the generated packs/profiles are asserted LF-deterministic (tests/unit/test_gen3_profile.py
# test_json_is_deterministic) and the pret symbol files are sha-pinned (test_gen3_syms_build.py
# published provenance). A fresh Windows lane checkout (core.autocrlf=true) turned both CRLF and
# failed the G4 release gate rehearsal (docs/gen3/probes/fc_release_gate_quick_d0a4bba5.txt).
data/games/gen3_*/*.json text eol=lf
data/gen3/pret/* text eol=lf
# Gen 2 RGBDS snapshots are hashed as emitted (CRLF on the pinned Windows toolchain).
# Preserve these bytes in Git; text normalization would invalidate the source lock.
data/gen2/*.sym -text whitespace=cr-at-eol
data/gen2/*.map -text whitespace=cr-at-eol
data/gen2_sources.lock.json text eol=lf
data/gen2/*.json text eol=lf
data/games/gen2_*/*.json text eol=lf
data/games/gen2_*/overlay/*.json text eol=lf
data/games/gen2_*/charmap.lua text eol=lf

# Gen 2 coverage-map lane hashes these raw working-tree bytes against pins in
# docs/gen2/gen2_coverage_map.md (tools/coverage_map.py --requirements/--protocol/--map).
# Without eol=lf, a CRLF checkout (core.autocrlf=true) mismatches the LF-computed pins.
docs/gen2/gen2_requirements.md text eol=lf
docs/protocol.md text eol=lf
docs/gen2/gen2_coverage_map.md text eol=lf

# Written LF by tools/gen_gen1_write_checkpoint.py --kind overlay (write_text newline="
"); index is LF too.
# Without this, core.autocrlf=true reports the LF working copy as modified with no content diff.
data/games/gen1_purergb/write_checkpoint_overlay.json text eol=lf
# generated harness table: its --check compares bytes, so a CRLF checkout must not rewrite it
lua/tests/gen3_title_syms_exp_28877d73.lua text eol=lf

# patch/dist/companion_version.json records the sha256 of every shipped file in patch/dist, and the
# tools write them with LF; a CRLF checkout would make make_release refuse its own release.
patch/dist/*.json text eol=lf
