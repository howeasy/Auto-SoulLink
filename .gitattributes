# The overlay sources are hashed raw by overlay_provenance.json; keep them LF on every checkout.
patch/gen1/purergb/** text eol=lf
patch/upr/*.patch text eol=lf

# These are hashed byte-for-byte against sha256 pins in data/games/gen1_rby/profile.json,
# data/games/gen1_purergb/profile.json, data/purergb/build_provenance.json and
# data/purergb/overlay_provenance.json. The pins were computed on LF bytes (CI, and the
# build tools' own writes); without this, Windows checkouts (core.autocrlf=true) see CRLF
# and every one of those hash checks mismatches (they passed on the original committer's
# machine only because autocrlf hadn't corrupted the checkout yet at generation time).
data/pret/*.sym text eol=lf
data/purergb/*.sym text eol=lf
data/purergb/*.map text eol=lf

# Gen 3: the generated packs/profiles are asserted LF-deterministic (tests/unit/test_gen3_profile.py
# test_json_is_deterministic) and the pret symbol files are sha-pinned (test_gen3_syms_build.py
# published provenance). A fresh Windows lane checkout (core.autocrlf=true) turned both CRLF and
# failed the G4 release gate rehearsal (docs/gen3/probes/fc_release_gate_quick_d0a4bba5.txt).
data/games/gen3_*/*.json text eol=lf
data/gen3/pret/*.sym text eol=lf
